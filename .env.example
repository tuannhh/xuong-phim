# Chép thành .env (cùng thư mục, KHÔNG commit) rồi sửa — dùng cho docker compose.
# Nơi gom phim thành phẩm trên máy thật
XUONG_OUTPUT_DIR=/Users/ten/Movies/Xưởng phim
# Thư mục chứa tư liệu trên máy thật — gắn chỉ-đọc vào Docker với CÙNG đường dẫn, nên dán đường dẫn trong form như bình thường
TU_LIEU_DIR=/Users/ten/Documents
# Đăng nhập Claude cho các nút AI: chạy `claude setup-token` trên máy thật rồi dán mã vào đây (hoặc dùng ANTHROPIC_API_KEY)
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Giọng Gemini dự phòng khi VieNeu lỗi (tuỳ chọn)
GEMINI_API_KEY=
