# Cấu hình tts-vi. Chép thành config.env (cùng thư mục, đã gitignore) rồi sửa đường dẫn.
# Khoá KHÔNG chép vào đây — chỉ trỏ tới file khoá có sẵn trên máy.
VIENEU_DIR=~/VieNeu-TTS
VIENEU_VOICE=Hải Đăng
# Thứ tự thử: vieneu → gemini-api → gemini-agent (bỏ engine nào không có khoá)
ENGINE_ORDER=vieneu,gemini-api,gemini-agent

# Dự phòng 1: Gemini API key — file có dòng "API key: ..." hoặc "GEMINI_API_KEY=..." (hoặc đặt biến môi trường GEMINI_API_KEY)
GEMINI_KEY_FILE=
# Dự phòng 2: Gemini Agent Platform (Vertex) bằng service account JSON (cần gcloud)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_LOCATION=global

GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Charon
# Ghim giọng Bắc (đi qua speechMetadata.style nên không bị đọc thành tiếng)
GEMINI_STYLE=Standard Northern Vietnamese accent (Hà Nội); clear, warm narrator
